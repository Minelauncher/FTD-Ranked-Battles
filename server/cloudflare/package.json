{
  "name": "ftd-ranked-cloudflare",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node --check src/index.js",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  }
}
